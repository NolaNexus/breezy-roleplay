# Environment variables understood by the breezy-roleplay CLI.
#
# Copy to .env for local use and never commit the result. Every variable has a
# safe default, so an empty environment is fully functional.

# Emit JSON log lines on stderr (default: true).
# Set to false for plain "<logger>: <message>" output while debugging.
# BREEZY_FEATURE_STRUCTURED_LOGS=true

# Include metadata.json and metrics.json in session archives (default: true).
# BREEZY_FEATURE_ARCHIVE_MANIFEST=true

# Append Prometheus textfile samples to this path (default: unset, disabled).
# The parent directory is created on demand.
# BREEZY_METRICS_FILE=./logs/breezy.prom

# Trace identifier stamped on every log entry (default: a fresh UUID4 hex).
# This is a value, not a path, and it must never hold a real credential.
# BREEZY_TRACE_ID=0123456789abcdef0123456789abcdef

# Optional: Semgrep App Token for the security review workflow.
# Never commit a real value; set it as a GitHub Actions secret instead.
# SEMGREP_APP_TOKEN=
